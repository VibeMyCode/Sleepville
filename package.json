{
  "name": "sleepville",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-i18n.mjs && vite build",
    "sounds": "node scripts/build-sounds.mjs",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
